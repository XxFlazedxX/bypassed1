local function getMainRope()
    local ropesFolder = workspace:FindFirstChild("Ropes")
    local userRopeFolder = ropesFolder and ropesFolder:FindFirstChild(player.Name)
    return userRopeFolder and userRopeFolder:FindFirstChild("mainConnectionRope")
end

local function toggleKill()
    grappleKillEnabled = not grappleKillEnabled
    local character = player.Character or player.CharacterAdded:Wait()

    if not grappleKillEnabled then
        for part, original in pairs(previousCollisions) do
            if part and part:IsA("BasePart") then
                part.CanCollide = original.CanCollide
                part.CanTouch = original.CanTouch
            end
        end
        previousCollisions = {}
    else
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and not previousCollisions[part] then
                previousCollisions[part] = {CanCollide=part.CanCollide, CanTouch=part.CanTouch}
                part.CanCollide=false
                part.CanTouch=false
            end
        end
    end

    local damagePart = workspace:FindFirstChild("Pit") and workspace.Pit:FindFirstChild("Damage")
    if damagePart then
        if grappleKillEnabled then
            damagePart.CFrame = character:WaitForChild("HumanoidRootPart").CFrame
            damagePart.Size = Vector3.new(9999,9999,9999)
        else
            damagePart.CFrame = CFrame.new(0,-15.75,0)
            damagePart.Size = Vector3.new(3.5,33,33)
        end
    end

    local ragdoll = character:FindFirstChild("ragdollValue")
    if ragdoll then ragdoll:Destroy() end
end

local function toggleBoosts()
    boostsEnabled = not boostsEnabled
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:WaitForChild("HumanoidRootPart")

    local jumpBoost = workspace:FindFirstChild("Map") and workspace.Map.Cool.Boosts:FindFirstChild("Jump")
    local speedBoost = workspace:FindFirstChild("Map") and workspace.Map.Cool.Boosts:FindFirstChild("Speed")

    if jumpBoost and jumpBoost:FindFirstChild("touchDetector") then
        jumpBoost.touchDetector.CFrame = root.CFrame
        jumpBoost.touchDetector.Size = boostsEnabled and Vector3.new(9999,9999,9999) or Vector3.new(1,1,1)
    end

    if speedBoost and speedBoost:FindFirstChild("touchDetector") then
        speedBoost.touchDetector.CFrame = root.CFrame
        speedBoost.touchDetector.Size = boostsEnabled and Vector3.new(9999,9999,9999) or Vector3.new(1,1,1)
    end
end

local adminScripts = {
    {
        name = "🎀 anti",
        code = [[
            local RunService = game:GetService("RunService")
            local player = game.Players.LocalPlayer
            local antiGrappleEnabled = false
            local antiGrappleConnection = nil
            local hookHitboxes = {}
            local TELEPORT_DISTANCE = 8

            local function createHitbox(hook)
                local hitbox = Instance.new("Part")
                hitbox.Size = Vector3.new(4, 4, 130)
                hitbox.Anchored = true
                hitbox.CanCollide = false
                hitbox.CanTouch = false
                hitbox.Transparency = 0.8
                hitbox.Material = Enum.Material.ForceField
                hitbox.Color = Color3.new(1, 0.75, 0.8)
                hitbox.Name = "LocalGrappleHitbox"
                hitbox.Parent = workspace
                hookHitboxes[hook] = hitbox
            end

            local function removeHitbox(hook)
                if hookHitboxes[hook] then
                    hookHitboxes[hook]:Destroy()
                    hookHitboxes[hook] = nil
                end
            end

            local function updateHitboxes()
                local ropesFolder = workspace:FindFirstChild("Ropes")
                local existingHooks = {}

                if ropesFolder and ropesFolder:IsA("Folder") then
                    for _, playerFolder in pairs(ropesFolder:GetChildren()) do
                        if playerFolder:IsA("Folder") and playerFolder.Name ~= player.Name then
                            for _, hook in pairs(playerFolder:GetChildren()) do
                                if hook:IsA("BasePart") and hook.Name == "Hook" then
                                    existingHooks[hook] = true
                                    if not hookHitboxes[hook] then
                                        createHitbox(hook)
                                    end
                                    hookHitboxes[hook].CFrame = hook.CFrame * CFrame.new(0, 0, -75)
                                end
                            end
                        end
                    end
                end

                for hook in pairs(hookHitboxes) do
                    if not existingHooks[hook] or not hook.Parent then
                        removeHitbox(hook)
                    end
                end
            end

            local function isPointInPart(part, point)
                local relative = part.CFrame:PointToObjectSpace(point)
                local size = part.Size / 2
                return math.abs(relative.X) <= size.X
                    and math.abs(relative.Y) <= size.Y
                    and math.abs(relative.Z) <= size.Z
            end

            local function isSafePosition(position)
                for _, hitbox in pairs(hookHitboxes) do
                    if isPointInPart(hitbox, position) then
                        return false
                    end
                end
                return true
            end

            local function getSafeTeleportPosition(currentPosition)
                local character = player.Character
                if not character then
                    return currentPosition
                end

                local hrp = character:FindFirstChild("HumanoidRootPart")
                if not hrp then
                    return currentPosition
                end

                for _ = 1, 10 do
                    local angle = math.random() * 2 * math.pi
                    local direction = Vector3.new(math.cos(angle), 0, math.sin(angle)).Unit
                    local offset = direction * TELEPORT_DISTANCE
                    local newPos = hrp.Position + offset

                    if isSafePosition(newPos) then
                        local params = RaycastParams.new()
                        params.FilterType = Enum.RaycastFilterType.Exclude
                        params.FilterDescendantsInstances = {character}

                        local result = workspace:Raycast(newPos + Vector3.new(0, 20, 0), Vector3.new(0, -100, 0), params)
                        if result and result.Instance and result.Instance.CanCollide then
                            local finalPos = result.Position + Vector3.new(0, 3, 0)

                            if finalPos.Y <= hrp.Position.Y + 12 then
                                return finalPos
                            end
                        end
                    end
                end
                return hrp.Position
            end

            local function onAntiGrappleHeartbeat()
                local character = player.Character
                if not character then return end

                local hrp = character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                updateHitboxes()

                for _, hitbox in pairs(hookHitboxes) do
                    if isPointInPart(hitbox, hrp.Position) then
                        local newPos = getSafeTeleportPosition(hrp.Position)
                        if (newPos - hrp.Position).Magnitude > 1 then
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            character:MoveTo(newPos)
                        end
                        return
                    end
                end
            end

            if not _G.antiGrapple then
                _G.antiGrapple = {enabled = false, connection = nil}
            end

            _G.antiGrapple.enabled = not _G.antiGrapple.enabled

            if _G.antiGrapple.enabled then
                if _G.antiGrapple.connection then
                    _G.antiGrapple.connection:Disconnect()
                end
                _G.antiGrapple.connection = RunService.Heartbeat:Connect(onAntiGrappleHeartbeat)
            else
                for _, hitbox in pairs(hookHitboxes) do 
                    hitbox:Destroy() 
                end
                hookHitboxes = {}
                if _G.antiGrapple.connection then
                    _G.antiGrapple.connection:Disconnect()
                    _G.antiGrapple.connection = nil
                end
            end
        ]]
