RunService.RenderStepped:Connect(function()

    local rope = getMainRope()
    if not rope then return end

    local smoothFactor = 0.45

    if isSmoothPullActive then

        rope.WinchEnabled = false
        local target = 5
        rope.Length = rope.Length + (target - rope.Length) * smoothFactor

    elseif isEaseInActive then

        rope.WinchEnabled = true
        rope.WinchSpeed = easeInWinchSettings.on.Speed
        rope.WinchResponsiveness = easeInWinchSettings.on.Responsiveness
        rope.WinchTarget = easeInWinchSettings.on.Target

    else

        rope.WinchEnabled = false
        local target = rope.Length + smoothThrowDistance
        rope.Length = rope.Length + (target - rope.Length) * smoothFactor

    end

end)
